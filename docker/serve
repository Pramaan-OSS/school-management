#!/bin/sh
set -eu
cd /app
python docker/setup.py
node /app/vendor/framework/socketio.js > /app/.runtime/bench/logs/socket.log 2>&1 &
socket_pid=$!
node /app/docker/gateway.mjs > /app/.runtime/bench/logs/gateway.log 2>&1 &
gateway_pid=$!
cd /app/.runtime/bench/sites
python -m frappe.utils.bench_helper frappe worker > ../logs/worker.log 2>&1 &
worker_pid=$!
scheduler_pid=""
if [ "$(cat ../.outside-configured)" = yes ]; then
  python -m frappe.utils.bench_helper frappe schedule > ../logs/scheduler.log 2>&1 &
  scheduler_pid=$!
fi
cleanup() { kill "$socket_pid" "$gateway_pid" "$worker_pid" ${scheduler_pid:+"$scheduler_pid"} 2>/dev/null || true; }
trap cleanup EXIT INT TERM
case "${SCHOOL_SERVER_MODE:-development}" in
  production)
    gunicorn --bind 127.0.0.1:8081 --workers 2 --threads 4 --timeout 120 'education.wsgi:create_app()'
    ;;
  development)
    python -m frappe.utils.bench_helper frappe --site "$SCHOOL_SITE_NAME" serve --port 8081 --noreload
    ;;
  *) printf '%s\n' 'Choose development or production server mode.' >&2; exit 1 ;;
esac
